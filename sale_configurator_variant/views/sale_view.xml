<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="sale_order_line_config_variant_view_form_base" model="ir.ui.view">
        <field name="model">sale.order.line</field>
        <field
            name="inherit_id"
            ref="sale_configurator_base.sale_order_line_config_base_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='product_id']" position="before">
                <field name="is_configurable_with_variant" />
                <field
                    name="product_template_id"
                    invisible="not is_configurable_with_variant"
                    required="is_configurable_with_variant"
                />
            </xpath>
            <xpath expr="//field[@name='product_id']/.." position="attributes">
                <attribute name="invisible">is_configurable_with_variant</attribute>
            </xpath>
            <xpath expr="//label[@for='product_id']" position="attributes">
                <attribute name="invisible">is_configurable_with_variant</attribute>
            </xpath>
            <xpath expr="//field[@name='product_uom_qty']" position="attributes">
                <attribute name="readonly">variant_ids</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="after">
                <label for="variant_ids" invisible="not is_configurable_with_variant" />
                <field
                    name="variant_ids"
                    context="{'default_order_id': order_id}"
                    invisible="not is_configurable_with_variant"
                >
                    <list editable="bottom">
                        <!-- There is some magic here, please look at models/ir_ui_view.py
                    We dynamically retrieve all the fields from the
                    sale.order.line list defined in the original sale.order form view.
                        -->
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_config_variant_view_form" model="ir.ui.view">
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale_order_line_config_variant_view_form_base" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='variant_ids']/list/field[@name='product_template_id']"
                position="attributes"
            >
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='variant_ids']/list/field[@name='product_id']"
                position="attributes"
            >
                <attribute name="domain" operation="domain_add" join_operator="AND">
                    [('product_tmpl_id','=', parent.product_template_id)]
                </attribute>
            </xpath>
            <xpath
                expr="//field[@name='variant_ids']/list/field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="sum">Total</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_sale_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//notebook//field[@name='order_line']//list//field[@name='product_id']"
                position="before"
            >
                <!-- Need to be present in view for JS patch -->
                <field name="is_configurable_with_variant" column_invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
