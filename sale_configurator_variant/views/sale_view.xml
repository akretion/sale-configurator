<?xml version='1.0' encoding='utf-8' ?>
<odoo>
    <record id="sale_order_line_config_variant_view_form_base" model="ir.ui.view">
        <field name="model">sale.order.line</field>
        <field
            name="inherit_id"
            ref="sale_configurator_base.sale_order_line_config_base_view_form"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="before">
                <field name="is_multi_variant_line" />
                <field
                    name="product_template_id"
                    invisible="not is_multi_variant_line"
                    required="is_multi_variant_line"
                />
            </xpath>
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="readonly">not product_updatable</attribute>
                <attribute name="invisible">is_multi_variant_line</attribute>
                <attribute name="required">not display_type</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="after">
                <label for="variant_ids" invisible="not is_multi_variant_line" />
                <field
                    name="variant_ids"
                    context="{'default_order_id': order_id}"
                    invisible="not is_multi_variant_line"
                >
                    <list editable="bottom">
                        <!-- There is some magic here, please look at models/ir_ui_view.py
                             We dynamically retrieve all field from the sale order form
                        -->
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_config_variant_view_form" model="ir.ui.view">
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale_order_line_config_variant_view_form_base" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='variant_ids']/list/field[@name='product_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('product_tmpl_id','=', parent.product_template_id)]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='variant_ids']/list/field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="sum">Total</attribute>
            </xpath>
        </field>
    </record>
</odoo>
