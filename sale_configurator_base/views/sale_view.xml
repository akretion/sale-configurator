<odoo>
    <record id="sale_order_line_config_base_view_form" model="ir.ui.view">
        <field name="name">sale.order.line.config.base.form</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <form string="Sale Order Line base Configurator">
                <!-- There is some magic here, please look at models/ir_ui_view.py
                    We dynamically retrieve all the fields from the
                    sale.order.line form defined in the original sale.order form view.
                -->
                <footer>
                    <button
                        name="save_add_product_and_close"
                        string="Save &amp; Close"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="save_add_product_and_new"
                        string="Save &amp; New"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        name="cancel"
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_sale_line_config_base">
        <field name="name">Sale Line Configure bases</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="sale_order_line_config_base_view_form" />
    </record>

    <record id="view_order_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="before">
                <button
                    name="%(action_sale_line_config_base)d"
                    type="action"
                    string="Add Configurable Product"
                    class="btn-primary oe_edit_only oe_left"
                    invisible="state not in ('draft', 'sent')"
                    context="{'default_order_id': id,
                      'default_name': '/', }"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']//list" position="attributes">
                <attribute name="decoration-it">parent_id</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list/field[@name='price_subtotal']"
                position="attributes"
            >
                <attribute name="invisible">"hide_subtotal"</attribute>
                <attribute name="string">Opt Subtotal</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list/field[@name='price_subtotal']"
                position="after"
            >
                <field
                    name="price_config_subtotal"
                    invisible="parent_id"
                    string="Subtotal"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list/field[@name='sequence']"
                position="after"
            >
                <button
                    name="open_sale_line_config_base"
                    type="object"
                    icon="fa-th"
                    invisible="not is_configurable"
                    string="Open Configurable Product"
                />
            </xpath>
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="bases">{'reload_on_button': true}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']//list/field[@name='product_template_id']"
                position="attributes"
            >
                <attribute name="class">product</attribute>
            </xpath>
        </field>
    </record>

    <menuitem
        id="menu_product_configurator"
        parent="sale.menu_sale_config"
        sequence="100"
        name="Product Configurator"
    />
</odoo>
