<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_configurator_template_list_view" model="ir.ui.view">
        <field name="name">product.configurator.template.list</field>
        <field name="model">product.configurator.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" class="col-2" />
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="product_configurator_template_form_view" model="ir.ui.view">
        <field name="name">product.configurator.template.form</field>
        <field name="model">product.configurator.template</field>
        <field name="arch" type="xml">
            <form string="Configurator Template">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <label
                            class="oe_edit_only"
                            for="name"
                            string="Configurator Template Name"
                        />
                        <h1>
                            <field
                                name="name"
                                placeholder="Configurator Template Name"
                            />
                        </h1>
                    </div>
                    <group>
                        <field name="code" />
                    </group>
                    <notebook>
                        <page string="Options" name="option_ids">
                            <group name="option_settings">
                                <field
                                    name="option_ids"
                                    nolabel="1"
                                    colspan="4"
                                    mode="list"
                                />
                                <field
                                    name="description"
                                    colspan="4"
                                    nolabel="1"
                                    placeholder="This note is only for internal purposes."
                                />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="product_configurator_template_search_view" model="ir.ui.view">
        <field name="name">product.configurator.template.search</field>
        <field name="model">product.configurator.template</field>
        <field name="arch" type="xml">
            <search string="Product Configurator Templates">
                <field
                    name="name"
                    string="Configurator Template"
                    filter_domain="['|', ('code', 'ilike', self), ('name', 'ilike', self), ]"
                />
                <field
                    name="option_ids"
                    string="Options"
                    filter_domain="[('Product.product_id', 'ilike', self)]"
                />
                <separator />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active','=',False)]"
                />
                <separator />
            </search>
        </field>
    </record>
    <record id="product_configurator_template_action" model="ir.actions.act_window">
        <field name="name">Product Configurator Templates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.configurator.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="product_configurator_template_list_view" />
        <field name="search_view_id" ref="product_configurator_template_search_view" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Product Configurator Template
        </p>
        </field>
    </record>
    <menuitem
        action="product_configurator_template_action"
        id="menu_configurator_template"
        name="Product Configurator Templates"
        parent="sale_configurator_base.menu_product_configurator"
        sequence="10"
    />
</odoo>
