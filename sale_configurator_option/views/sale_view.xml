<odoo>
    <record id="sale_order_line_config_option_view_form_base" model="ir.ui.view">
        <field name="model">sale.order.line</field>
        <field
            name="inherit_id"
            ref="sale_configurator_base.sale_order_line_config_base_view_form"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//group/group/div/field[@name='product_id']"
                position="attributes"
            >
                <attribute name="context" operation="update">
                    {
                        "add_default_option": True,
                    }
                </attribute>
            </xpath>
            <xpath
                expr="//group/group/div/field[@name='product_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[("is_configurable_opt", "=", True)]</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <label for="option_ids" invisible="not is_configurable_opt" />
                <field
                    name="option_ids"
                    context="{'default_order_id': order_id}"
                    invisible="not is_configurable_opt"
                >
                    <list editable="bottom">
                        <!-- There is some magic here, please look at models/ir_ui_view.py
                    We dynamically retrieve all the fields from the
                    sale.order.line list defined in the original sale.order form view.
                -->
                    </list>
                </field>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_config_option_view_form" model="ir.ui.view">
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale_order_line_config_option_view_form_base" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='option_ids']/list/field[@name='product_uom_qty']"
                position="before"
            >
                <field name="option_unit_qty" string="Qty" />
                <field name="option_qty_type" string="Qty type" optional="hide" />
            </xpath>
            <xpath
                expr="//field[@name='option_ids']/list/field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="readonly">1</attribute>
                <attribute name="string">Total Qty</attribute>
            </xpath>
            <xpath
                expr="//field[@name='option_ids']/list/field[@name='product_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('is_option', '=', True),('used_in_configurable_product_ids', '=', parent.product_id)]</attribute>
            </xpath>
            <xpath
                expr="//field[@name='option_ids']/list/field[@name='product_template_id']"
                position="attributes"
            >
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='option_ids']/list/field[@name='product_id']"
                position="attributes"
            >
                <attribute name="optional" />
                <attribute name="string">Product</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_sale_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//notebook//field[@name='order_line']//list//field[@name='product_id']"
                position="attributes"
            >
                <attribute name="domain" operation="domain_add" join_operator="AND">
                    [('is_not_sold_alone', '=', False)]
                </attribute>
            </xpath>
            <xpath
                expr="//notebook//field[@name='order_line']//list//field[@name='product_template_id']"
                position="attributes"
            >
                <attribute name="domain" operation="domain_add" join_operator="AND">
                    [('is_not_sold_alone', '=', False)]
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
