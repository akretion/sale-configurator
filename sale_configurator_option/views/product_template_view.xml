<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="%(product_configurator_option_action)d"
                    type="action"
                    context="{'search_default_option_product_tmpl_id': id}"
                    class="oe_stat_button"
                    icon="fa-level-up"
                    invisible="count_used_as_option == 0"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field
                                name="count_used_as_option"
                                widget="statinfo"
                                nolabel="1"
                            />
                        </span>
                        <span class="o_stat_text">Used as Option</span>
                    </div>
                </button>
            </div>
            <xpath expr="//page[@name='sales']" position="after">
                <page name="config_options" string="Configurator Options">
                    <group name="options">
                        <group name="setting" colspan="4">
                            <field name="is_configurable_opt" invisible="is_option" />
                            <field name="is_option" invisible="is_configurable_opt" />
                            <field
                                name="configurator_id"
                                invisible="not is_configurable_opt"
                                colspan="2"
                            />
                            <field name="is_not_sold_alone" invisible="not is_option" />
                        </group>
                        <group
                            name="specific_options"
                            string="Specific Options"
                            invisible="not is_configurable_opt or configurator_id"
                            colspan="4"
                        >
                            <field name="specific_option_ids" nolabel="1" mode="list" />
                        </group>
                        <group
                            name="configurator_options"
                            string="Options"
                            invisible="not is_configurable_opt or not configurator_id"
                            colspan="4"
                        >
                            <field name="option_ids" nolabel="1" mode="list" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Special search_default context on Variant views to match product.product's ID
        instead of product.template's ID -->
    <record model="ir.ui.view" id="product_normal_form_view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//button[@name='%(product_configurator_option_action)d']"
                position="attributes"
            >
                <attribute name="context">
                    {'search_default_option_product_id': id}
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
