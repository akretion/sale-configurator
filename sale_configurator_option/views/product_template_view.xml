<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="%(product_configurator_option_action)d"
                    type="action"
                    context="{'search_default_option_product_tmpl_id': context.get('active_id')}"
                    class="oe_stat_button"
                    icon="fa-level-up"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field
                                name="count_used_on_option_line"
                                widget="statinfo"
                                nolabel="1"
                            />
                        </span>
                        <span class="o_stat_text">Used In Configurable</span>
                    </div>
                </button>
            </div>
            <xpath expr="//page[@name='sales']" position="after">
                <page name="config_options" string="Configurator Options">
                    <group name="options">
                        <group name="setting" colspan="4">
                            <field name="is_configurable_opt" invisible="is_option" />
                            <field name="is_option" invisible="is_configurable_opt" />
                            <field
                                name="product_conf_tmpl_id"
                                invisible="not is_configurable_opt"
                                colspan="2"
                            />
                            <field
                                name="sale_alone_forbidden"
                                invisible="is_configurable_opt"
                            />
                        </group>
                        <group
                            name="local_options"
                            string="Local Options"
                            invisible="not is_configurable_opt or product_conf_tmpl_id"
                            colspan="4"
                        >
                            <field
                                name="local_configurable_option_ids"
                                nolabel="1"
                                mode="list"
                            />
                        </group>
                        <group
                            name="template_options"
                            string="Template Options"
                            invisible="not is_configurable_opt or not product_conf_tmpl_id"
                            colspan="4"
                        >
                            <field
                                name="configurable_option_ids"
                                nolabel="1"
                                mode="list"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
