<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_configurator_option_view_list" model="ir.ui.view">
        <field name="model">product.configurator.option</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="sequence" widget="handle" />
                <field name="option_product_id" />
                <field name="option_qty_type" />
                <field name="product_uom_id" />
                <field name="is_default_option" />
            </list>
        </field>
    </record>

    <record id="product_configurator_option_full_view_list" model="ir.ui.view">
        <field name="model">product.configurator.option</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="configurator_id" />
                <field name="configurable_product_tmpl_id" />
                <field name="option_product_id" />
                <field name="option_qty_type" />
                <field name="product_uom_id" />
                <field name="is_default_option" />
            </list>
        </field>
    </record>

    <record id="product_configurator_option_view_search" model="ir.ui.view">
        <field name="model">product.configurator.option</field>
        <field name="arch" type="xml">
            <search string="Option">
                <field name="configurator_id" />
                <field
                    name="configurable_product_tmpl_id"
                    domain="[('is_configurable_opt', '=', True)]"
                />
                <field
                    name="option_product_tmpl_id"
                    domain="[('is_option', '=', True)]"
                />
                <field name="option_product_id" domain="[('is_option', '=', True)]" />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active','=',False)]"
                />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="product_configurator_option_action">
        <field name="name">Option</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.configurator.option</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="product_configurator_option_full_view_list" />
        <field name="search_view_id" ref="product_configurator_option_view_search" />
    </record>
</odoo>
